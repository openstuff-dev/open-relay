# Copy to .env and adjust. docker compose reads it automatically.

# Port on this machine.
PORT=8080

# How much the server logs: fatal, error, warn, info, debug or trace.
LOG_LEVEL=info

# The database password. Change it before you put this on a server.
POSTGRES_PASSWORD=openrelay

# Where people reach OpenRelay, without a trailing slash. The QR codes on labels and the links
# in customers' emails point here, so set it before you print labels. Sign-in cookies are
# marked Secure when it starts with https://.
OPENRELAY_PUBLIC_URL=http://localhost:8080

# The first admin, made on the first start. Leave the password empty to have one made and
# shown once in the log.
OPENRELAY_ADMIN_EMAIL=admin@example.com
OPENRELAY_ADMIN_PASSWORD=

# How many days people stay signed in.
OPENRELAY_SESSION_DAYS=30

# Where customers' emails are sent: smtp://user:password@host:587 or smtps://…:465.
# Empty: emails are written to the log instead, which is fine for trying it out.
# To read them in a browser: OPENRELAY_SMTP_URL=smtp://mailpit:1025 and
#   docker compose --profile mail up -d
OPENRELAY_SMTP_URL=
OPENRELAY_MAIL_FROM=OpenRelay <noreply@localhost>

# How many days a parcel waits at the pick-up point before it's overdue. Customers get a
# reminder 2 days before.
OPENRELAY_HOLD_DAYS=14

# How many days after a parcel is collected or cancelled the customer's name, email, phone and
# address are deleted. The scan history stays.
OPENRELAY_RETENTION_DAYS=90

# A Nominatim-compatible geocoder (https://nominatim.org), to offer customers the nearest
# points by distance and fill in points' coordinates. Empty: points are matched by postcode.
# The public nominatim.openstreetmap.org allows light use only; run your own for more.
OPENRELAY_GEOCODER_URL=

# Behind a reverse proxy (nginx, Caddy, Traefik): true, or the proxy's addresses, so
# rate limits see the real client address.
OPENRELAY_TRUST_PROXY=
