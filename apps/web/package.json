{
  "name": "@open-relay/web",
  "version": "0.1.1",
  "private": true,
  "scripts": {
    "ng": "ng",
    "tokens": "os-tokens",
    "serve": "node copy-zxing.mjs && ng serve",
    "build": "node copy-zxing.mjs && ng build",
    "watch": "ng build --watch --configuration development",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "stylelint": "stylelint \"src/**/*.css\"",
    "zxing": "node copy-zxing.mjs"
  },
  "dependencies": {
    "@angular/aria": "~22.2.4",
    "@angular/cdk": "~22.2.4",
    "@angular/common": "~22.2.3",
    "@angular/compiler": "~22.2.3",
    "@angular/core": "~22.2.3",
    "@angular/forms": "~22.2.3",
    "@angular/platform-browser": "~22.2.3",
    "@angular/router": "~22.2.3",
    "@open-relay/contracts": "*",
    "@openstuff-dev/announce": "^0.1.0",
    "@openstuff-dev/tokens": "^0.1.1",
    "@openstuff-dev/ui": "^0.1.8",
    "@openstuff-dev/ui-angular": "^0.1.8",
    "@openstuff-dev/version": "^0.1.0",
    "barcode-detector": "^3.2.3",
    "lucide": "^1.67.0",
    "qrcode": "^1.5.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "~22.2.4",
    "@angular/cli": "~22.2.4",
    "@angular/compiler-cli": "~22.2.3",
    "@types/qrcode": "^1.5.6",
    "typescript": "~6.0.3"
  },
  "nx": {
    "name": "web",
    "tags": [
      "type:app"
    ],
    "targets": {
      "tokens": {
        "cache": true,
        "inputs": [
          "{projectRoot}/tokens.config.json",
          {
            "externalDependencies": [
              "@openstuff-dev/tokens"
            ]
          }
        ],
        "outputs": [
          "{projectRoot}/src/tokens"
        ]
      },
      "build": {
        "dependsOn": [
          "tokens"
        ],
        "outputs": [
          "{projectRoot}/dist"
        ]
      },
      "serve": {
        "dependsOn": [
          "tokens"
        ],
        "continuous": true
      },
      "watch": {
        "dependsOn": [
          "tokens"
        ],
        "continuous": true
      },
      "typecheck": {
        "dependsOn": [
          "tokens"
        ]
      },
      "stylelint": {
        "dependsOn": [
          "tokens"
        ]
      }
    }
  }
}
